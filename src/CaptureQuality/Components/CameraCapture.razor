@namespace CaptureQuality.Components

<div class="capture-container">
    <div class="camera-wrapper">
        <video id="cameraVideo" playsinline muted></video>
        <canvas id="cameraCanvas" style="display: none;"></canvas>
        
        @if (_cameraActive)
        {
            <div class="live-indicator">
                <span class="live-dot"></span>
                AO VIVO
            </div>
        }

        @if (_canSwitchCamera && _cameraActive)
        {
            <button class="camera-switch-btn @(_isSwitchingCamera ? "switching" : "")" 
                    @onclick="ToggleCameraAsync" 
                    disabled="@_isSwitchingCamera"
                    title="Trocar câmera">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 3L5 6.99h3V14h2V6.99h3L9 3zm7 14.01V10h-2v7.01h-3L15 21l4-3.99h-3z"/>
                </svg>
                @if (_isSwitchingCamera)
                {
                    <span>Trocando...</span>
                }
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-message error-info">@_errorMessage</div>
    }

    @if (_showFileUpload)
    {
        <label class="capture-button file-upload-btn">
            Escolher Imagem
            <InputFile style="display:none;" OnChange="OnFileSelected" accept="image/*" />
        </label>
    }
    else if (_isCameraOff)
    {
        <button class="capture-button" @onclick="InitCamera">
            @_buttonText
        </button>
    }
    else
    {
        <button class="capture-button" @onclick="CaptureImage" disabled="@_isCapturing">
            @_buttonText
        </button>
    }
</div>

@code {
    [Parameter] public EventCallback<Models.CapturedImagePayload> OnImageCaptured { get; set; }

    [Inject] private IJSRuntime? JSRuntime { get; set; }

    private bool _isCapturing;
    private bool _isCameraOff = true;
    private bool _cameraInitialized;
    private bool _cameraActive;
    private bool _showFileUpload;
    private string _errorMessage = "";
    private string _buttonText = "Iniciar Câmera";
    private int _initAttempts;
    private string _currentFacingMode = "environment";
    private bool _canSwitchCamera;
    private bool _isSwitchingCamera;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_cameraInitialized)
        {
            await InitCamera();
        }
    }

    private async Task InitCamera()
    {
        _initAttempts++;
        
        if (JSRuntime == null)
        {
            if (_initAttempts < 10)
            {
                await Task.Delay(500);
                await InitCamera();
            }
            else
            {
                _errorMessage = "Nenhum dispositivo disponível";
                _showFileUpload = true;
                _isCameraOff = true;
            }
            return;
        }

        try
        {
            _errorMessage = "Procurando câmera...";
            _buttonText = "Procurando...";
            StateHasChanged();

            var result = await JSRuntime.InvokeAsync<CameraInfoResult>("captureQuality.initCamera", "cameraVideo", "cameraCanvas", _currentFacingMode);
            
            if (result?.Success == true)
            {
                await Task.Delay(500);
                
                _isCameraOff = false;
                _cameraActive = true;
                _canSwitchCamera = result.CanSwitch;
                _currentFacingMode = result.FacingMode ?? "environment";
                _errorMessage = "";
                _buttonText = "Capturar Imagem";
            }
            else
            {
                throw new Exception(result?.Error ?? "Falha ao inicializar câmera");
            }
        }
        catch
        {
            _errorMessage = "Nenhum dispositivo disponível";
            _showFileUpload = true;
            _isCameraOff = true;
            _cameraActive = false;
        }
        finally
        {
            _cameraInitialized = true;
            StateHasChanged();
        }
    }

    private async Task ToggleCameraAsync()
    {
        if (_isSwitchingCamera || !_cameraActive || JSRuntime == null)
            return;
            
        _isSwitchingCamera = true;
        StateHasChanged();
        
        try
        {
            _currentFacingMode = _currentFacingMode == "environment" ? "user" : "environment";
            var result = await JSRuntime.InvokeAsync<CameraInfoResult>("captureQuality.initCamera", "cameraVideo", "cameraCanvas", _currentFacingMode);
            
            if (result?.Success == true)
            {
                _canSwitchCamera = result.CanSwitch;
                _cameraActive = true;
                _errorMessage = "";
            }
            else
            {
                _currentFacingMode = _currentFacingMode == "environment" ? "user" : "environment";
                _cameraActive = true;
                _canSwitchCamera = result?.CanSwitch ?? _canSwitchCamera;
                _errorMessage = result?.Error ?? "Erro ao trocar câmera";
            }
        }
        catch (Exception ex)
        {
            _currentFacingMode = _currentFacingMode == "environment" ? "user" : "environment";
            _errorMessage = $"Erro ao trocar câmera: {ex.Message}";
        }
        finally
        {
            _isSwitchingCamera = false;
            StateHasChanged();
        }
    }

    private async Task CaptureImage()
    {
        if (_isCapturing) return;
        if (JSRuntime == null) return;

        _isCapturing = true;
        _buttonText = "Capturando...";
        _errorMessage = "Capturando...";
        StateHasChanged();

        try
        {
            Console.WriteLine($"[CameraCapture:CaptureImage] inicio.");
            await using var imageStreamReference = await JSRuntime.InvokeAsync<IJSStreamReference?>(
                "captureQuality.getImageBytes",
                "cameraVideo", 
                "cameraCanvas");
            Console.WriteLine($"[CameraCapture:CaptureImage] imageStreamReference: {imageStreamReference}");
            if (imageStreamReference is null)
            {
                _errorMessage = "Falha ao capturar. Tente novamente.";
                return;
            }
            Console.WriteLine($"[CameraCapture:CaptureImage] Iniciando openstream: {imageStreamReference}");
            await using var imageStream = await imageStreamReference.OpenReadStreamAsync(10 * 1024 * 1024);
            Console.WriteLine($"[CameraCapture:CaptureImage] imageStream: {imageStream}");
            using var imageBuffer = new MemoryStream();
            await imageStream.CopyToAsync(imageBuffer);
            Console.WriteLine($"[CameraCapture:CaptureImage] imageStream: {imageStream}");
            var imageBytes = imageBuffer.ToArray();
            Console.WriteLine($"[CameraCapture:CaptureImage] imageBytes: {imageBytes}");
                  
            if (imageBytes is null || imageBytes.Length == 0)
            {
                _errorMessage = "Falha ao capturar. Tente novamente.";
                return;
            }
            
            _errorMessage = "";
            Console.WriteLine($"[CameraCapture:CaptureImage] Calling OnImageCaptured.InvokeAsync...");
            await OnImageCaptured.InvokeAsync(new Models.CapturedImagePayload
            {
                Bytes = imageBytes,
                ContentType = "image/png",
                FileName = $"capture-{DateTime.UtcNow:yyyyMMddHHmmss}.png",
                ThumbnailUrl = $"data:image/png;base64,{Convert.ToBase64String(imageBytes)}"
            });
            Console.WriteLine($"[CameraCapture:CaptureImage] OnImageCaptured.InvokeAsync returned");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao capturar: {ex.Message}";
        }
        finally
        {
            Console.WriteLine($"[CameraCapture:CaptureImage] finally executed - resetting button. _isCapturing={_isCapturing}");
            _isCapturing = false;
            _buttonText = "Capturar Imagem";
            Console.WriteLine($"[CameraCapture:CaptureImage] After reset - _isCapturing={_isCapturing}, _buttonText={_buttonText}");
            StateHasChanged();
            Console.WriteLine($"[CameraCapture:CaptureImage] StateHasChanged called");
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var thumbnailBytes = ms.ToArray();

        await OnImageCaptured.InvokeAsync(new Models.CapturedImagePayload
        {
            BrowserFile = file,
            ContentType = file.ContentType,
            FileName = file.Name,
            ThumbnailUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(thumbnailBytes)}"
        });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime!.InvokeVoidAsync("captureQuality.stopCamera", "cameraVideo");
        }
        catch
        {
        }
    }

    private class CameraInfoResult
    {
        public bool Success { get; set; }
        public string? FacingMode { get; set; }
        public bool CanSwitch { get; set; }
        public string? DeviceId { get; set; }
        public string? Error { get; set; }
    }
}