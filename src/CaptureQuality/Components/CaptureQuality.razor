@namespace CaptureQuality.Components

<div class="capture-component">
    <div class="page-header">
        <h1>Detecção de Qualidade</h1>
    </div>

    <CameraCapture OnImageCaptured="OnImageCapturedHandler" />

    @if (_capturedImage != null && !_isProcessing)
    {
        <div class="preview-container">
            <img src="@_capturedImage" class="preview-image" alt="Captured" />
        </div>
    }

    @if (_isProcessing)
    {
        <div class="loading-overlay">
            <div class="loading-content">
                <div class="spinner"></div>
                <p>Analisando imagem...</p>
            </div>
        </div>
    }

    @if (_result != null)
    {
        <QualityResult Result="_result" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-message">
            @_errorMessage
        </div>
    }
</div>

@code {
    [Inject] private Services.BlurDetectorService? BlurDetector { get; set; }

    private bool _isProcessing;
    private Services.BlurDetectionResult? _result;
    private string _errorMessage = "";
    private string? _capturedImage;

    private async Task OnImageCapturedHandler(string imageData)
    {
        if (string.IsNullOrEmpty(imageData) || BlurDetector == null)
            return;

        // CRITICAL FIX: Update UI state immediately before any processing
        _capturedImage = imageData;
        _isProcessing = true;
        _errorMessage = "";
        _result = null;
        
        // CRITICAL FIX: Force UI to update NOW so loading overlay appears
        StateHasChanged();

        try
        {
            var base64Data = imageData.Replace("data:image/png;base64,", "");
            var imageBytes = Convert.FromBase64String(base64Data);

            using var stream = new MemoryStream(imageBytes);
            
            // CRITICAL FIX: Run CPU-intensive work on background thread
            // Task.Run schedules the entire async method on a thread pool thread
            // This prevents UI freezing during SVD/K-means computation
            _result = await Task.Run(() => BlurDetector.DetectBlurAsync(stream));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao processar imagem: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }
}
