@namespace CaptureQuality.Components

<div class="capture-component">
    <div class="page-header">
        <h1>Detecção de Qualidade</h1>
    </div>

    <CameraCapture OnImageCaptured="OnImageCapturedHandler" />

    @if (_capturedImage != null && !_isProcessing)
    {
        <div class="preview-container">
            <img src="@_capturedImage" class="preview-image" alt="Captured" />
        </div>
    }

    @if (_isProcessing)
    {
        <div class="loading-overlay">
            <div class="loading-content">
                <div class="spinner"></div>
                <p>Analisando imagem...</p>
            </div>
        </div>
    }

    <ProcessingQueue />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-message">
            @_errorMessage
        </div>
    }
</div>

@code {
    [Inject] private Services.ImageProcessingQueueService? QueueService { get; set; }

    private bool _isProcessing;
    private string _errorMessage = "";
    private string? _capturedImage;

    private async Task OnImageCapturedHandler(Models.CapturedImagePayload image)
    {
        Console.WriteLine($"[CaptureQuality:OnImageCapturedHandler] ENTRY - thumbnail length: {image?.ThumbnailUrl?.Length ?? 0}");

        if (image == null || string.IsNullOrEmpty(image.ThumbnailUrl) || QueueService == null)
        {
            Console.WriteLine($"[CaptureQuality:OnImageCapturedHandler] EARLY EXIT - image missing: {image == null}, QueueService null: {QueueService == null}");
            return;
        }

        _capturedImage = image.ThumbnailUrl;
        _isProcessing = true;
        _errorMessage = "";

        StateHasChanged();

        try
        {
            Console.WriteLine($"[CaptureQuality:OnImageCapturedHandler] Calling QueueService.AddAsync...");
            var result = await QueueService.AddAsync(image);
            Console.WriteLine($"[CaptureQuality:OnImageCapturedHandler] QueueService.AddAsync returned item ID: {result.Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CaptureQuality:OnImageCapturedHandler] EXCEPTION: {ex.GetType().Name} - {ex.Message}");
            _errorMessage = $"Erro ao processar imagem: {ex.Message}";
        }
        finally
        {
            Console.WriteLine($"[CaptureQuality:OnImageCapturedHandler] finally executed");
            _isProcessing = false;
            StateHasChanged();
            Console.WriteLine($"[CaptureQuality:OnImageCapturedHandler] EXIT");
        }
    }
}
