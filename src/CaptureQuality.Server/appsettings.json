{
  "BlurDetection": {
    "Engine": "OpenCvSpike",
    "OpenCvSpike": {
      "PatchSize": 40,
      "MaxImageDimension": 1600,
      "MinUsefulContentRatio": 0.08,
      "BlurVarianceThreshold": 90.0,
      "BlurRatioThreshold": 0.5,
      "PreBlurKernelSize": 3,
      "AdaptiveThresholdBlockSize": 31,
      "AdaptiveThresholdC": 15.0,
      "MorphologyKernelSize": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
