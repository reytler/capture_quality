{
  "BlurDetection": {
    "Engine": "Legacy",
    "OpenCvSpike": {
      "PatchSize": 64,
      "MaxImageDimension": 1200,
      "BlurVarianceThreshold": 140.0,
      "BlurRatioThreshold": 0.4
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
