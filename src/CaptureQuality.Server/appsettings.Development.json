{
  "BlurDetection": {
    "Engine": "OpenCvSpike",
    "OpenCvSpike": {
      "PatchSize": 40,
      "MaxImageDimension": 1600,
      "MinUsefulContentRatio": 0.12,
      "MinUsefulImageRatio": 0.02,
      "BlurVarianceThreshold": 140.0,
      "BlurRatioThreshold": 0.35,
      "MinEligiblePatchCount": 6,
      "MinEligiblePatchRatio": 0.05,
      "MinMedianVariance": 160.0,
      "PreBlurKernelSize": 3,
      "AdaptiveThresholdBlockSize": 31,
      "AdaptiveThresholdC": 15.0,
      "MorphologyKernelSize": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
